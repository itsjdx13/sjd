{
  "name": "roco-guys-phase1-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test tests/responsive-app.spec.ts",
    "test": "playwright test tests/responsive-app.spec.ts tests/design-foundation.spec.ts tests/phase1-flows.spec.ts tests/continuation.spec.ts tests/export-selection.spec.ts tests/xlsx.spec.ts tests/accessibility-workflows.spec.ts tests/storage-reliability.spec.ts tests/request-persistence.spec.ts tests/admin-persistence.spec.ts tests/hr-shared-data.spec.ts",
    "test:pwa": "npm run build && playwright test -c playwright.pwa.config.ts",
    "setup:firefox": "node scripts/test-firefox.mjs --install",
    "test:firefox": "node scripts/test-firefox.mjs",
    "test:a11y:firefox": "node scripts/test-firefox.mjs -c playwright.accessibility.config.ts",
    "test:requests:firefox": "node scripts/test-firefox.mjs -c playwright.request-persistence.config.ts",
    "qa:screens": "node scripts/capture-qa.mjs",
    "test:legacy-mobile-runtime": "playwright test tests/mobile-runtime.spec.ts",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/build-pwa.mjs && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@fontsource/estedad": "^5.3.0",
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@types/qrcode": "^1.5.6",
    "@use-gesture/react": "10.3.1",
    "exceljs": "4.4.0",
    "jsqr": "^1.4.0",
    "motion": "12.42.2",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
